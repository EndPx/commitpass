{
  "name": "@commitpass/cre",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@chainlink/cre-sdk": "1.22.0",
    "@commitpass/shared": "workspace:*",
    "viem": "2.56.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@commitpass/typescript-config": "workspace:*",
    "@types/bun": "1.3.8",
    "typescript": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "compile:wasm": "cre-compile lifecycle/main.ts dist/lifecycle.wasm",
    "simulate": "cre workflow simulate lifecycle --target testnet-settings --non-interactive",
    "local": "pnpm --filter @commitpass/shared build && pnpm compile:wasm && node local/run.mjs"
  }
}
