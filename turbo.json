{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["go.work"],
  "tasks": {
    "@commitpass/indexer#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [".envio/**", "envio-env.d.ts"]
    },
    "@commitpass/indexer#typecheck": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [".envio/**", "envio-env.d.ts"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@commitpass/api#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "@commitpass/api#typecheck": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "@commitpass/shared#typecheck": {
      "cache": false,
      "outputs": []
    },
    "@commitpass/api#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "INDEXER_DATABASE_URL",
        "PRIVY_APP_ID",
        "PRIVY_APP_SECRET",
        "ATTENDANCE_API_TOKEN",
        "MONAD_RPC_URL",
        "CORS_ALLOWED_ORIGINS"
      ]
    }
  }
}
