# Used by the individual factory/vault deployment scripts.
YIELD_VAULT=
ORGANIZER=
FACTORY=
STAKE_AMOUNT=
REGISTRATION_DEADLINE=
EVENT_DATE=
MAX_PARTICIPANTS=
SETTLE_AT=
# Etherscan API v2 key for Monadscan source verification.
ETHERSCAN_API_KEY=
